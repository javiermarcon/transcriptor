# Ejemplo de configuración para meetings-transcriptor.
# Copiá a: ~/.config/meetings-transcriptor.env
# y ajustá valores. No versionar tokens reales.
#
#   mkdir -p ~/.config
#   cp meetings-transcriptor.env.example ~/.config/meetings-transcriptor.env
#   chmod 600 ~/.config/meetings-transcriptor.env
#
# Abajo: perfil CUDA validado (p. ej. RTX 3090).
# Para laptop sin GPU, usá el bloque CPU comentado al final.

export HF_TOKEN='hf_REEMPLAZAR'

export TRANSCRIPTOR_VENV="$HOME/proyectos/meetings/transcriptor/.venv"
export WHISPERX_BIN="$TRANSCRIPTOR_VENV/bin/whisperx"
export WHISPER_CTRANSLATE2_BIN="$TRANSCRIPTOR_VENV/bin/whisper-ctranslate2"

# export BASE_DIR="$HOME/proyectos/meetings/textos_reuniones"

# --- Perfil CUDA (default recomendado con NVIDIA) ---
export DEVICE=cuda
export COMPUTE_TYPE=float16
export MODELO=large-v3
export BATCH_SIZE=16
export THREADS=8

export VAD_METHOD=pyannote
export VAD_ONSET=0.45
export VAD_OFFSET=0.363
export CHUNK_SIZE=30

export TEMPERATURE=0
export BEST_OF=5
export BEAM_SIZE=8
export PATIENCE=1.0
export TEMPERATURE_INCREMENT_ON_FALLBACK=0.2
export COMPRESSION_RATIO_THRESHOLD=2.4
export LOGPROB_THRESHOLD=-1.0
export NO_SPEECH_THRESHOLD=0.55
export CONDITION_ON_PREVIOUS_TEXT=0
export FILTER_HALLUCINATIONS=1
# export EXTRA_HALLUCINATION_PHRASES="frase basura, otra frase"
# export MIN_SPEAKERS=2
# export MAX_SPEAKERS=5

# Grabación (opcionales)
# export VOLUMEN_SISTEMA=0.70
# export VOLUMEN_MICROFONO=2.00
# export SINK=alsa_output...
# export MIC=alsa_input...
export RECORD_VIDEO=true
export VIDEO_MONITOR=primary
export VIDEO_FPS=10

# Native Messaging (extensión Firefox). El host NO hace fallback silencioso a monitor.
# export NATIVE_MESSAGING_PROFILE=shipii
# export NATIVE_VIDEO_SOURCE=window   # default: window (X11 por título; Wayland vía portal)
# export NATIVE_VIDEO_SOURCE=monitor  # fallback explícito (X11=xrandr; Wayland=portal monitor)
# export NATIVE_HOST_SYSTEM_PYTHON=/usr/bin/python3  # PyGObject para el portal Wayland

# Atribución de hablantes (capa adicional sobre SPEAKER_XX; no inventa nombres).
# Nombre del participante local (micrófono de esta máquina), p. ej. Javier:
# export LOCAL_PARTICIPANT_NAME=Javier

# Evidencia visual (fotogramas para frases con «acá», «este botón», …). Ver docs/VISUAL_EVIDENCE.md
# export VISUAL_EVIDENCE_CONTEXT_BEFORE_S=1.5
# export VISUAL_EVIDENCE_CONTEXT_AFTER_S=2.5
# export VISUAL_EVIDENCE_FRAME_INTERVAL_S=1.0
# export VISUAL_EVIDENCE_MAX_FRAMES_PER_CANDIDATE=4
# export VISUAL_EVIDENCE_EXTRA_PATTERNS='custom:\bmirá\s+esto\b'

# --- Alternativa CPU (laptop sin GPU); comentá el bloque CUDA y descomentá esto ---
# export DEVICE=cpu
# export COMPUTE_TYPE=int8
# export MODELO=large-v3
# export BATCH_SIZE=2
# export THREADS=4
